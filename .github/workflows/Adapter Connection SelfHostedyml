name: self-hosted - Adapter connection package checkout

on:
  workflow_dispatch:
    inputs:
     Adapter_ConfigPkg:
      description: "Package consists of adapter connection"
      type: string
     Target_Env:
      description: "Target environment to deploy connection"
      type: string

jobs:
 deploy:
  runs-on: [self-hosted, windows]
  
  environment:
   name: ${{ inputs.Target_Env }}

  steps:
   - name: Checkout repository
     uses: actions/checkout@v4
     with:
      fetch-depth: 1
      
   - name: Create deploy directory
     shell: powershell
     run: |
       $deployPath = "${{ github.workspace }}\deploy"
       if (-not (Test-Path $deployPath)) {
         New-Item -ItemType Directory -Path $deployPath -Force | Out-Null
       }
       Write-Host "✓ Deploy directory created at: $deployPath"
       
   - name: Checkout Selected Package (excluding config)
     shell: powershell
     run: |
       $sourcePath = "${{ github.workspace }}\${{ inputs.Adapter_ConfigPkg }}"
       $destPath = "${{ github.workspace }}\deploy\${{ inputs.Adapter_ConfigPkg }}"
       
       Write-Host "Source: $sourcePath"
       Write-Host "Destination: $destPath"
       
       if (-not (Test-Path $sourcePath)) {
         Write-Host "✗ Source package not found: $sourcePath"
         exit 1
       }
       
       # Create destination directory
       New-Item -ItemType Directory -Path $destPath -Force | Out-Null
       
       # Copy all files and directories except config folder
       Get-ChildItem -Path $sourcePath -Recurse | ForEach-Object {
         $relativePath = $_.FullName.Substring($sourcePath.Length).TrimStart('\')
         
         if ($_ -is [System.IO.FileInfo]) {
           # Skip files in config directory
           if (-not $_.FullName.Contains("\config\")) {
             $targetFile = Join-Path $destPath $relativePath
             $targetDir = Split-Path $targetFile -Parent
             if (-not (Test-Path $targetDir)) {
               New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
             }
             Copy-Item -Path $_.FullName -Destination $targetFile -Force
           }
         }
       }
       
       # Create empty config directory
       $configDir = Join-Path $destPath "config"
       New-Item -ItemType Directory -Path $configDir -Force | Out-Null
       Write-Host "✓ Package structure copied (excluding config)"

   - name: Copy only required Environment Configuration
     shell: powershell
     run: |
       $configFile = "${{ github.workspace }}\config\JDBCConnDetails_${{ inputs.Target_Env }}.csv"
       $destDir = "${{ github.workspace }}\deploy\${{ inputs.Adapter_ConfigPkg }}\config\"
       
       Write-Host "Copying only ${{ inputs.Target_Env }} config file"
       Write-Host "Source: $configFile"
       Write-Host "Destination: $destDir"
       
       if (-not (Test-Path $configFile)) {
         Write-Host "✗ Config file not found: $configFile"
         Write-Host "Available config files:"
         Get-ChildItem "${{ github.workspace }}\config\" -Filter "*.csv" | ForEach-Object { Write-Host "  - $($_.Name)" }
         exit 1
       }
       
       if (-not (Test-Path $destDir)) {
         New-Item -ItemType Directory -Path $destDir -Force | Out-Null
       }
       
       Copy-Item -Path $configFile -Destination $destDir -Force
       Write-Host "✓ Environment-specific config file copied successfully"

   - name: Verify deployment folder
     shell: powershell
     run: |
       $deployPath = "${{ github.workspace }}\deploy\${{ inputs.Adapter_ConfigPkg }}\config"
       
       Write-Host "Files in deployment config directory:"
       Get-ChildItem -Path $deployPath -File | ForEach-Object {
         Write-Host "  - $($_.Name)"
       }
       
       $fileCount = (Get-ChildItem -Path $deployPath -File).Count
       Write-Host ""
       Write-Host "Total files in config: $fileCount"
       
       if ($fileCount -ne 1) {
         Write-Host "⚠ Warning: Expected 1 file, found $fileCount"
       } else {
         Write-Host "✓ Correct number of config files"
       }

   - name: Deploy Package
     shell: powershell
     run: |
       Write-Host "Deploying Package ${{ inputs.Adapter_ConfigPkg }}"
       Write-Host "Environment ${{ inputs.Target_Env }}"
       Write-Host "Deployment location: ${{ github.workspace }}\deploy\${{ inputs.Adapter_ConfigPkg }}"
